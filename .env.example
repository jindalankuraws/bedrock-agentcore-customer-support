# Copy to .env and fill in from your own deployment.
# Every value here is account-specific; none of it is secret, but none of it is committed.

# --- AWS ---
# Optional: a named AWS CLI profile for the local UI and scripts. Omit to use
# the default credential chain.
# AWS_PROFILE=default
AWS_REGION=ap-southeast-1

# --- Agent runtime (SSM /telco-support/runtime/arn) ---
AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:ap-southeast-1:<account-id>:runtime/<agent-id>
AGENT_ENDPOINT=live

# --- Model ---
MODEL_ID=apac.amazon.nova-pro-v1:0

# All of these are published to SSM under /telco-support by the platform stacks;
# the deployed runtime reads them from there. This file is for running locally.

# --- Guardrail (outputs of platform/20-guardrail.yaml) ---
GUARDRAIL_ID=<guardrail-id>
GUARDRAIL_VERSION=1

# --- Knowledge base (outputs of platform/30-knowledge-base.yaml) ---
# KB_REGION defaults to the runtime's own region; set it only if the knowledge
# base was deployed elsewhere (the tested variant - see docs/PROJECT_OVERVIEW.md).
KB_ID=<knowledge-base-id>
KB_REGION=ap-southeast-1

# --- Gateway (set from SSM by platform/60-runtime.yaml in the deployed runtime;
#     only needed when running the agent locally) ---
# AGENTCORE_GATEWAY_TELCO_GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.ap-southeast-1.amazonaws.com/mcp

# --- Evaluation (agent/eval/run_batch_eval.py) ---
EVAL_LOG_GROUP=/aws/bedrock-agentcore/runtimes/<agent-id>-live
EVAL_SERVICE_NAME=<agent-id>.live
